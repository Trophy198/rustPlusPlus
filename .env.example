# Copy this file to `.env` and fill in your values. `.env` is gitignored.
RPP_DISCORD_TOKEN=your-discord-bot-token
RPP_DISCORD_CLIENT_ID=your-discord-application-client-id

# Optional overrides
# RPP_WEB_ENABLED=true          # Live map Web UI (default on)
# RPP_WEB_PORT=3000             # Web UI port
# RPP_POLLING_INTERVAL=10000    # Rust+ poll interval in ms
# RPP_LANGUAGE=en
